<% if (errors.length > 0) { %>
  <div class="bg-red-100 border border-red-600 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
    <strong class="text-red-700 font-bold"
    style="color: red;">Error!</strong>
    <ul class="block sm:inline list-disc list-inside">
      <% errors.forEach(error => { %>
        <li><%= error %></li>
      <% }) %>
    </ul>
  </div>
<% } %>