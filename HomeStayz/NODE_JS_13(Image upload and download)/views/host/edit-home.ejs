<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main class="container mx-auto mt-8 p-8 bg-white rounded-lg shadow-md">
      <h1 class="text-3xl font-bold mb-6 text-center text-gray-800"><%= editing ? "Edit" : "Register"%> Your Home on AirBnB</h1>
      <form action="/host/<%= editing ? "edit-home" :
      "add-home" %>"method="POST"
      enctype="multipart/form-data" 
      class="max-w-md mx-auto">

      <input type="hidden" name="id"
      value = "<%= editing ? home._id: '' %>"/>


        <input
          type="text"
          name="houseName"
          value="<%= editing ? home.houseName : '' %>"
          placeholder="Enter your House Name"
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
        />

        <!-- <input
          type="text"
          name="price"
          value="<%= editing ? home.price : '' %>"
          placeholder="Enter your House price"
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
        /> -->

        <input
        type="number" 
        name="price"
        value="<%= editing ? home.price : '' %>"
        placeholder="Enter price (Numbers only, e.g. 1000)"
        class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
        required
        />

        <input
          type="text"
          name="location"
          value="<%= editing ? home.location : '' %>"
          placeholder="Enter your House location"
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
        />

        <input
          type="text"
          name="rating"
          value="<%= editing ? home.rating : '' %>"
          placeholder="Enter your House rating"
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
        />

        <label class="block mb-1 text-sm text-gray-600">Upload Image of Hotel</label>
        <input
         type="file"
         name="photourl"
         class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
        />

        <label class="block mb-1 text-sm text-gray-600">Upload Rules PDF (optional)</label>
        <input
          type="file"
          name="rulesPdf"
          accept="application/pdf"
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
        />

        <textarea
          type="text"
          name="description"
          placeholder="Enter your House description"
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
        ><%= editing ? home.description : '' %></textarea>

        <input type="submit" value="<%= editing ? "Update Home" : "Add Home"%>" class="w-full bg-red-500 text-white py-2 rounded-md hover:bg-red-600 transition duration-300" />
      </form>
    </main>
  </body>
</html>